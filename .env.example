# Investing Together — environment variable documentation.
# Copy to `.env` on the droplet (root-owned, chmod 600) and fill in real values.
# This file is committed; `.env` is NOT. Every variable the app/worker uses is documented here.
# (Grows as phases add adapters — BUILD-PLAN §1.3.)

# --- Claude API (required — the only required external runtime) ---
ANTHROPIC_API_KEY=        # all 8 engines' reasoning calls

# --- Cost & model controls ---
MONTHLY_SPEND_CEILING_USD=50      # hard budget; engines alert/halt before exceeding
LLM_MODEL_OVERRIDE=claude-haiku-4-5   # TESTING: force all engines onto one cheap model
                                      # (unset later to use the opus/sonnet/haiku tiering in ARCHITECTURE §7.1)

# --- DigitalOcean (Phase 0 provisioning) ---
# DO_API_TOKEN=           # doctl read/write — Spaces buckets, firewalls, snapshots
# SPACES_KEY=             # DO Spaces (S3-compatible) access key
# SPACES_SECRET=          # DO Spaces secret
# SPACES_BUCKET=          # raw filings / PDFs / audio / rendered artifacts
# SPACES_REGION=          # e.g. nyc3
# SPACES_ENDPOINT=        # e.g. https://nyc3.digitaloceanspaces.com

# --- Database (Phase 1) ---
# DATABASE_URL=           # postgres://... self-hosted Postgres + pgvector

# --- Public URL + webhooks (Phase 2) ---
# PUBLIC_BASE_URL=              # e.g. https://markets.kuramoto.io (used to build webhook URLs)
# TRADINGVIEW_WEBHOOK_SECRET=   # shared-secret token embedded in TradingView alert JSON
# FILING_WEBHOOK_SECRET=        # HMAC-SHA256 secret for the filing-arrival webhook

# --- Data-source adapters (supplied per-phase, BUILD-PLAN §1.3) ---
# FMP_API_KEY=                  # Financial Modeling Prep (Phase 1/4)
# FISCAL_AI_API_KEY=            # Fiscal.ai (Phase 4)
# SP_GLOBAL_API_KEY=            # S&P Global (Phase 4)
# MORNINGSTAR_API_KEY=          # Morningstar (Phase 4)
# MT_NEWSWIRES_API_KEY=         # MT Newswires (Phase 3/7)
# BIGDATA_API_KEY=              # Bigdata.com (Phase 3/7)
# RESEND_API_KEY=               # Resend → Substack newsletter delivery (Phase 8)

# Perplexity API (factual financial lookups: earnings dates, consensus, qualitative context)
PERPLEXITY_API_KEY=pplx-xxxxxxxx
