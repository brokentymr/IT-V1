# Investing Together — environment configuration
# Copy to .env and fill in. All data stays on owned infrastructure (section 7.1).

# --- Postgres (the proprietary knowledge base) ---
# Self-hosted Postgres + pgvector, or DO Managed Postgres.
DATABASE_URL=postgres://investing_together:change_me@localhost:5432/investing_together

# --- DO Spaces (S3-compatible) — raw filings, PDFs, audio, rendered artifacts ---
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=investing-together-raw
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=

# --- Claude API (the only required external runtime — agent reasoning) ---
ANTHROPIC_API_KEY=

# --- Webhook ingest (TradingView alerts + filing webhooks) ---
# Shared secret used to verify inbound webhook payloads.
WEBHOOK_INGEST_SECRET=

# --- Email (Resend -> Substack) ---
RESEND_API_KEY=
