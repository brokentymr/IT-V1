# Investing Together — reverse proxy with automatic HTTPS (Phase 2) + console auth (Phase 5).
{
	email brokentymr@gmail.com
}

# The platform + webhook host. Caddy auto-issues + renews a Let's Encrypt cert and
# redirects HTTP→HTTPS.
markets.kuramoto.io {
	encode gzip
	log {
		output file /var/log/caddy/access.log
		format json
	}

	# Webhooks authenticate with their own signed secrets — they must stay UNAUTHENTICATED
	# (TradingView/EDGAR can't send a basic-auth header). Everything else (the operator console)
	# is gated behind HTTP basic auth, since it exposes research and can trigger paid runs.
	@webhooks path /api/webhooks/*
	handle @webhooks {
		reverse_proxy localhost:3000
	}
	handle {
		basic_auth {
			operator $2a$14$WfZdJQXz4GaLQBmTw/1kouRMa0zmXcGxshaSEhLJbjQzoWF/jl/L2
		}
		reverse_proxy localhost:3000
	}
}
