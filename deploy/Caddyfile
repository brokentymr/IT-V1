# The platform + webhook host. Caddy auto-issues + renews a Let's Encrypt cert and
# redirects HTTP→HTTPS. Webhooks land at https://markets.kuramoto.io/api/webhooks/*.
markets.kuramoto.io {
	encode gzip
	log {
		output file /var/log/caddy/access.log
		format json
	}
	reverse_proxy localhost:3000
}
